{
  "name": "ferrufi-web",
  "version": "0.1.0",
  "private": true,
  "description": "Notebook UI for running the mufiz native runtime via Bun (bun:ffi) - server-backed notebook",
  "main": "index.html",
  "type": "commonjs",
  "scripts": {
    "inspect": "bun scripts/inspect_mufiz_bun.js",
    "inspect:call": "bun scripts/inspect_mufiz_bun.js -c \"print('hello')\"",
    "inspect:node": "node scripts/inspect_mufiz.js -c \"print('hello')\"",
    "start": "bun scripts/dev-server.js",
    "start:node": "node scripts/dev-server.js",
    "dev": "bun scripts/dev-server.js",
    "serve": "bun scripts/dev-server.js",
    "format": "prettier --write . || true"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "keywords": [
    "mufiz",
    "wasm",
    "ffi",
    "notebook",
    "ferrufi"
  ],
  "license": "MIT"
}
